# MemorialCode API — local environment (copy to `.env` and adjust)

# PostgreSQL (async driver: asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memorialcode

# React (Vite) frontend base URL — the 302 target for plate scans
FRONTEND_BASE_URL=http://localhost:5173

# This API's public base URL — printed inside every physical QR plate.
# Leave empty to emit relative scan URLs (useful behind a reverse proxy).
API_BASE_URL=http://localhost:8000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# What a scan does when the plate is missing / unassigned / damaged:
#   redirect  → 302 to {FRONTEND_BASE_URL}{RESOLVER_MISS_PATH}
#   not_found → plain HTTP 404
RESOLVER_MISS_MODE=redirect
RESOLVER_MISS_PATH=/setup

# Plate identifier generation
QR_CODE_LENGTH=8
MAX_BATCH_SIZE=1000

ENVIRONMENT=development
DB_ECHO=false
