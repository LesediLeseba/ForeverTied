# MemorialCode frontend — optional environment overrides (copy to `.env`).

# Leave empty (default) so every API call stays relative and is proxied by Vite
# in dev (`/api`, `/q` → FastAPI on :8000) or by your reverse proxy in prod.
# Only set this when the browser must reach a different origin directly, and
# remember to add that origin to the API's CORS_ORIGINS.
VITE_API_BASE_URL=
