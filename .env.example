# MemorialCode — local infrastructure environment.
#
# Copy this file to `.env` (which is git-ignored) and fill in the credential.
# docker-compose.yml reads it via env_file, so nothing sensitive is committed.
#
# To match the backend's default local DATABASE_URL in backend/.env.example,
# use the conventional local superuser credential. If you choose something
# stronger, update backend/.env to match.

POSTGRES_USER=postgres
POSTGRES_DB=memorialcode
POSTGRES_PASSWORD=
